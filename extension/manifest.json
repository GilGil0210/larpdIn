{
  "manifest_version": 3,
  "name": "Larpdin",
  "version": "0.1.0",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://larpdin-backend.onrender.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_title": "Larpdin",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "optional_host_permissions": [
    "https://*/*"
  ]
}
