# Copy to .env (git-ignored) for local runs: `cp .env.example .env`, then `node --env-file=.env dist/server.js`
# Optional: set both to require a bearer token for non-extension clients
# REQUIRE_DEMO_TOKEN=true
# DEMO_ACCESS_TOKEN=

# Gemini is the default and only enabled provider. Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# GEMINI_REASONING_EFFORT=low        # set empty to omit reasoning_effort
# GEMINI_MAX_TOKENS=8192
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Optional
# CORS_ORIGINS=http://localhost:5173
# GENERATION_DEADLINE_MS=90000       # total budget incl. retries and the repair attempt
# PORT=3000
# LOG_LEVEL=info
