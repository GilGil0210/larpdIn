# Copy to .env (git-ignored) for local runs: `cp .env.example .env`, then `node --env-file=.env dist/server.js`
DEMO_ACCESS_TOKEN=

# Providers are tried in order: Featherless first, Gemini as fallback.
# Only providers with an API key are used. Override the order with LLM_PROVIDERS.
# LLM_PROVIDERS=featherless,gemini
# PROVIDER_COOLDOWN_MS=120000        # skip a failing provider for this long

# Featherless (primary)
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=Qwen/Qwen2.5-7B-Instruct
# FEATHERLESS_TIMEOUT_MS=60000       # budget before falling back to Gemini
# FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

# Gemini (fallback). Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# GEMINI_REASONING_EFFORT=low        # set empty to omit reasoning_effort
# GEMINI_MAX_TOKENS=8192
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Optional
# CORS_ORIGINS=http://localhost:5173
# GENERATION_DEADLINE_MS=90000
# PORT=3000
# LOG_LEVEL=info
