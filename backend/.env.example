# Copy to .env (git-ignored) for local runs: `cp .env.example .env`, then `node --env-file=.env dist/server.js`
DEMO_ACCESS_TOKEN=

# LLM provider: gemini (default) or featherless. If unset, the provider whose API key is set is used.
LLM_PROVIDER=gemini

# Gemini (Google AI Studio key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# GEMINI_REASONING_EFFORT=low        # set empty to omit reasoning_effort
# GEMINI_MAX_TOKENS=8192
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Featherless (used when LLM_PROVIDER=featherless)
# FEATHERLESS_API_KEY=
# FEATHERLESS_MODEL=Qwen/Qwen2.5-7B-Instruct
# FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

# Optional
# CORS_ORIGINS=http://localhost:5173
# GENERATION_DEADLINE_MS=90000
# PORT=3000
# LOG_LEVEL=info
